connect_supply_net VDD -ports VDD
connect_supply_net VDDM -ports VDDM
connect_supply_net VSS -ports VSS


set_domain_supply_net pd_core -primary_power_net VDDM -primary_ground_net VSS



set_level_shifter LtoH_sig_to_core -domain pd_core  -applies_to inputs -rule low_to_high -location  self
set_level_shifter HtoL_sig_from_core -domain pd_core -applies_to outputs -rule high_to_low -location self

set_related_supply_net -power VDD -ground VSS
