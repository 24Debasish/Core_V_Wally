create_power_domain pd_core
create_supply_port VDD
create_supply_port VDDM 
create_supply_port VSS
create_supply_net VDD -domain pd_core
create_supply_net VDD -domain pd_core -reuse
create_supply_net VDDM -domain pd_core
create_supply_net VDDM -domain pd_core -reuse
create_supply_net VSS -domain pd_core
create_supply_net VSS -domain pd_core -reuse

#connect_supply_net VDD -ports {VDD  lsu_synth/VDD ieu_synth/VDD ifu_synth/VDD mdu_synth/VDD priv_synth/VDD hzu_synth/VDD fpu_synth/VDD ebu_synth/VDD}

#connect_supply_net VDDM -ports {VDDM  lsu_synth/VDDM ieu_synth/VDDM ifu_synth/VDDM mdu_synth/VDDM priv_synth/VDDM hzu_synth/VDDM fpu_synth/VDDM ebu_synth/VDDM}

